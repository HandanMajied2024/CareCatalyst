+/* Simulation Lab: CareCatalyst design system (Inter, white, black, red/blue/green/yellow accents) */
+.policy-app {
+  --fg: #0a0a0a;
+  --muted: #6b6b6b;
+  --line: #e6e6e6;
+  --surface: #f5f5f5;
+  --red: #e5262b;
+  --blue: #1f5eff;
+  --green: #14a44d;
+  --yellow: #ffc400;
+  --red-soft: #fdeaea;
+  --blue-soft: #e8efff;
+  --green-soft: #e6f6ec;
+  --yellow-soft: #fff6d6;
+  --base: #d4d4d4;
+  --gutter: clamp(20px, 5vw, 72px);
+  display: flex;
+  min-height: 100vh;
+  background: #fff;
+  color: var(--fg);
+  font-family: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
+  font-size: 17px;
+  line-height: 1.5;
+}
+.policy-app button, .policy-app select, .policy-app input { font: inherit; color: inherit; }
+.policy-app button { cursor: pointer; }
+.policy-app h1, .policy-app h2, .policy-app h3 { letter-spacing: -0.02em; line-height: 1.15; }
+
+/* Sidebar */
+.policy-sidebar { width: 260px; flex-shrink: 0; background: #fff; border-right: 1px solid var(--line); padding: 32px 20px; display: flex; flex-direction: column; position: fixed; inset: 0 auto 0 0; }
+.policy-brand { display: flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 800; letter-spacing: -0.02em; color: var(--fg); text-decoration: none; }
+.policy-brand > span:first-child { display: grid; place-items: center; background: var(--fg); color: #fff; border-radius: 12px; width: 40px; height: 40px; }
+.policy-brand .brand-dot { color: var(--blue); margin-left: -10px; }
+.policy-sidebar nav { display: grid; gap: 6px; margin-top: 40px; }
+.policy-sidebar nav button { border: 0; background: none; display: flex; align-items: center; gap: 12px; color: var(--fg); min-height: 48px; padding: 10px 14px; border-radius: 999px; text-align: left; font-size: 16px; white-space: nowrap; }
+.policy-sidebar nav button:hover { background: var(--surface); }
+.policy-sidebar nav button.active { background: var(--fg); color: #fff; font-weight: 600; }
+.nav-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); margin-left: auto; }
+.nav-count { font-size: 14px; margin-left: auto; background: var(--blue-soft); color: var(--blue); min-width: 26px; text-align: center; padding: 0 8px; border-radius: 999px; }
+.policy-sidebar nav button.active .nav-count { background: #fff; }
+.sidebar-note { margin: 48px 4px 20px; border-radius: 20px; padding: 24px 18px 0; background: var(--surface); overflow: hidden; }
+.sidebar-note h3 { font-size: 20px; font-weight: 700; margin: 0; }
+.note-decoration { height: 64px; display: flex; align-items: flex-end; gap: 8px; margin-top: 20px; }
+.note-decoration span { flex: 1; border-radius: 6px 6px 0 0; background: var(--base); height: 30%; }
+.note-decoration span:nth-child(2) { height: 45%; }
+.note-decoration span:nth-child(3) { height: 40%; }
+.note-decoration span:nth-child(4) { height: 70%; background: var(--green); }
+.note-decoration span:nth-child(5) { height: 63%; background: var(--green); }
+.note-decoration span:nth-child(6) { height: 85%; background: var(--green); }
+.note-decoration span:nth-child(7) { height: 100%; background: var(--green); }
+.sidebar-bottom { margin-top: auto; }
+.sidebar-bottom > button { background: none; border: 0; display: flex; align-items: center; gap: 10px; color: var(--fg); font-size: 16px; min-height: 48px; padding: 12px 8px; }
+.profile { display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--line); padding: 20px 0 0; }
+.profile > span { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--blue-soft); color: var(--blue); font-size: 14px; font-weight: 700; }
+.profile strong { display: block; font-size: 15px; font-weight: 600; }
+.profile small { font-size: 14px; color: var(--muted); display: block; }
+.profile > svg { margin-left: auto; }
+
+/* Topbar */
+.policy-content { margin-left: 260px; width: calc(100% - 260px); min-width: 0; }
+.policy-topbar { min-height: 72px; display: flex; align-items: center; gap: 20px; padding: 0 var(--gutter); background: #fff; border-bottom: 1px solid var(--line); }
+.policy-topbar > div { display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--muted); }
+.policy-topbar > div span { color: var(--fg); font-weight: 500; }
+.sandbox-badge { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; color: var(--fg); background: var(--yellow-soft); border-radius: 999px; font-size: 14px; font-weight: 600; padding: 8px 14px; }
+.icon-button { background: none; border: 0; min-width: 44px; min-height: 44px; border-radius: 999px; color: var(--fg); display: inline-flex; align-items: center; justify-content: center; }
+.icon-button:hover { background: var(--surface); }
+
+/* Main */
+.lab-main { max-width: 1440px; margin: auto; padding: 48px var(--gutter) 0; }
+.lab-heading { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 40px; }
+.lab-heading h1 { font-size: clamp(32px, 4vw, 48px); font-weight: 800; margin: 0; }
+.secondary-button, .primary-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: 999px; min-height: 48px; padding: 10px 20px; font-size: 16px; font-weight: 600; white-space: nowrap; }
+.secondary-button { background: #fff; border: 1px solid var(--line); color: var(--fg); }
+.secondary-button:hover { background: var(--surface); }
+.primary-button { background: var(--blue); border: 1px solid var(--blue); color: #fff; }
+.primary-button:hover { background: var(--fg); border-color: var(--fg); }
+
+.scenario-toolbar { border: 1px solid var(--line); border-radius: 20px; background: #fff; display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; margin-bottom: 32px; gap: 20px; flex-wrap: wrap; }
+.scenario-title { display: flex; align-items: center; gap: 14px; }
+.scenario-symbol { width: 44px; height: 44px; background: var(--blue-soft); border-radius: 12px; display: grid; place-items: center; color: var(--blue); }
+.scenario-title strong { font-size: 18px; font-weight: 700; display: block; }
+.scenario-selectors { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
+.scenario-selectors label { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 15px; }
+.scenario-selectors select { border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--fg); min-height: 44px; padding: 6px 14px; font-size: 16px; max-width: 220px; }
+.toolbar-divider { height: 28px; border-left: 1px solid var(--line); }
+.period-label { color: var(--muted); }
+
+.lab-grid { display: grid; grid-template-columns: minmax(340px, 0.9fr) minmax(400px, 1.4fr); gap: 32px; }
+.controls-panel, .map-panel, .projection-panel, .budget-panel, .compare-panel { border: 1px solid var(--line); border-radius: 20px; background: #fff; overflow: hidden; }
+.panel-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 24px 28px; }
+.panel-heading h2 { display: flex; gap: 10px; align-items: center; font-size: 22px; font-weight: 700; margin: 0; }
+.controls-panel > .panel-heading { border-bottom: 1px solid var(--line); }
+.panel-heading svg { color: var(--blue); }
+.control-body { padding: 8px 28px 28px; }
+
+.input-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px; }
+.input-pair label { font-size: 14px; color: var(--muted); }
+.input-pair label > div { display: flex; align-items: center; gap: 8px; border: 1px solid var(--line); border-radius: 12px; margin-top: 8px; padding: 0 14px; min-height: 52px; background: #fff; color: var(--muted); }
+.input-pair input { border: 0; outline: 0; width: 100%; min-width: 0; background: transparent; color: var(--fg); font-size: 20px; font-weight: 700; }
+.input-pair input::-webkit-inner-spin-button { appearance: none; }
+.control-separator { border-top: 1px solid var(--line); margin: 28px 0 4px; }
+
+.resource-control { margin-top: 24px; }
+.resource-title { display: flex; gap: 12px; align-items: center; }
+.resource-icon { width: 44px; height: 44px; display: grid; place-items: center; background: var(--surface); border-radius: 12px; color: var(--fg); flex-shrink: 0; }
+.resource-icon.hospital { background: var(--blue-soft); color: var(--blue); }
+.resource-icon.cars { background: var(--green-soft); color: var(--green); }
+.resource-icon.mobile { background: var(--yellow-soft); color: var(--fg); }
+.resource-title strong { font-size: 16px; font-weight: 600; display: block; }
+.resource-value { margin-left: auto; font-size: 28px; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
+.resource-value small { display: inline; font-size: 14px; font-weight: 500; color: var(--muted); }
+.resource-control input[type=range] { appearance: none; width: 100%; height: 44px; background: transparent; margin: 4px 0 0; cursor: pointer; display: block; }
+.resource-control input[type=range]::-webkit-slider-runnable-track { height: 10px; border-radius: 999px; background: linear-gradient(to right, var(--blue) 0 var(--progress), var(--surface) var(--progress) 100%); }
+.resource-control input[type=range]::-moz-range-track { height: 10px; border-radius: 999px; background: linear-gradient(to right, var(--blue) 0 var(--progress), var(--surface) var(--progress) 100%); }
+.resource-control input::-webkit-slider-thumb { appearance: none; height: 28px; width: 28px; margin-top: -9px; border: 4px solid #fff; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 1px var(--line), 0 2px 6px rgb(0 0 0 / .12); }
+.resource-control input::-moz-range-thumb { height: 20px; width: 20px; border: 4px solid #fff; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 1px var(--line); }
+.range-labels { display: flex; justify-content: space-between; color: var(--muted); font-size: 14px; }
+
+.winter-control { display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--line); margin-top: 28px; padding-top: 20px; }
+.winter-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: var(--yellow-soft); color: var(--fg); }
+.winter-control strong { display: block; font-size: 16px; font-weight: 600; }
+.toggle { margin-left: auto; width: 56px; height: 32px; border: 0; border-radius: 999px; background: var(--line); padding: 3px; flex-shrink: 0; }
+.toggle span { display: block; width: 26px; height: 26px; border-radius: 50%; background: #fff; transition: transform .2s; box-shadow: 0 1px 3px rgb(0 0 0 / .15); }
+.toggle.on { background: var(--yellow); }
+.toggle.on span { transform: translateX(24px); }
+.control-footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line); padding: 18px 28px; }
+.control-footer > span { font-size: 14px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
+.live-indicator { width: 10px; height: 10px; background: var(--green); border-radius: 50%; }
+
+/* Map */
+.map-panel { position: relative; display: flex; flex-direction: column; min-height: 560px; }
