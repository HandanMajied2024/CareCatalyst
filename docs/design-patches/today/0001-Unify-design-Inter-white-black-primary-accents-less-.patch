+.estimate-pill { display: inline-flex; gap: 8px; align-items: center; border-radius: 999px; background: var(--yellow-soft); color: var(--fg); font-size: 14px; font-weight: 600; padding: 8px 14px; white-space: nowrap; }
+.metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
+.metric-card { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 24px; min-width: 0; }
+.metric-label { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 500; color: var(--fg); }
+.metric-label svg { color: var(--blue); }
+.metric-value { font-size: 44px; font-weight: 800; letter-spacing: -0.02em; margin: 16px 0 12px; line-height: 1; font-variant-numeric: tabular-nums; }
+.metric-value > span { font-size: 16px; letter-spacing: 0; color: var(--muted); margin-left: 6px; font-weight: 500; }
+.metric-change > span { font-size: 14px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; background: var(--green-soft); border-radius: 999px; color: var(--green); padding: 4px 10px; }
+.metric-bars { display: grid; gap: 6px; margin-top: 16px; }
+.metric-bars > div { position: relative; height: 26px; background: var(--surface); border-radius: 999px; overflow: hidden; }
+.metric-bars i { position: absolute; inset: 0 auto 0 0; background: var(--base); border-radius: 999px; transition: width .3s; }
+.metric-bars i.now { background: var(--green); }
+.metric-bars b { position: relative; display: block; padding: 0 10px; font-size: 14px; line-height: 26px; font-weight: 700; color: var(--fg); font-variant-numeric: tabular-nums; }
+.metric-bars i.now + b { color: #fff; }
+
+.bottom-grid { display: grid; grid-template-columns: 1.65fr 1fr; gap: 24px; margin-top: 32px; }
+.projection-panel .panel-heading { padding-bottom: 0; flex-wrap: wrap; }
+.chart-legend { display: flex; gap: 16px; font-size: 14px; color: var(--fg); }
+.chart-legend span { display: flex; align-items: center; gap: 6px; }
+.chart-legend i { width: 16px; height: 4px; border-radius: 2px; background: var(--green); }
+.chart-legend span + span i { background: var(--base); }
+.projection-chart { position: relative; margin: 28px 28px 24px 72px; }
+.projection-chart svg { width: 100%; height: 140px; overflow: visible; }
+.chart-y { position: absolute; left: -52px; top: 0; bottom: 30px; display: flex; flex-direction: column; justify-content: space-between; font-size: 14px; color: var(--muted); }
+.chart-x { display: flex; justify-content: space-between; font-size: 14px; color: var(--muted); margin-top: 10px; }
+
+.budget-panel { display: flex; flex-direction: column; }
+.budget-panel .panel-heading { padding-bottom: 8px; flex-wrap: wrap; }
