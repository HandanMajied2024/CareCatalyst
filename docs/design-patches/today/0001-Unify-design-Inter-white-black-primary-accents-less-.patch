+.map-layers button.selected { background: var(--fg); color: #fff; }
+.region-map { width: 100%; height: 100%; min-height: 500px; flex: 1; }
+.map-compass { position: absolute; top: 80px; right: 32px; color: var(--muted); font-size: 14px; font-weight: 600; display: grid; text-align: center; gap: 2px; }
+.map-compass span { font-size: 24px; color: var(--fg); }
+.map-insight { position: absolute; left: 24px; right: 24px; bottom: 76px; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 16px 18px; display: flex; align-items: center; gap: 14px; box-shadow: 0 4px 16px rgb(0 0 0 / .05); }
+.map-insight > span { background: var(--green-soft); color: var(--green); padding: 10px; border-radius: 12px; display: grid; place-items: center; }
+.map-insight strong { display: block; font-size: 32px; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
+.map-insight strong span { font-size: 16px; font-weight: 500; color: var(--muted); }
+.map-insight > svg { margin-left: auto; color: var(--green); }
+.map-legend { position: absolute; bottom: 0; left: 0; right: 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; padding: 16px 28px; background: #fff; font-size: 14px; color: var(--fg); }
+.map-legend > span { display: flex; align-items: center; gap: 8px; }
+.map-legend i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: var(--fg); }
+.map-legend i.legend-mobile { background: var(--blue); }
+.map-legend i.legend-gap { background: var(--red); }
+.map-scale { margin-left: auto; color: var(--muted); }
+
+/* Outcomes */
+.outcomes-heading { display: flex; justify-content: space-between; align-items: center; margin: 56px 0 24px; gap: 12px; }
