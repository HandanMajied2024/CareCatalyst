+  .budget-value { margin: 8px 20px 16px; font-size: 34px; }
+  .budget-track { margin: 0 20px; }
+  .budget-caption { margin: 10px 20px 20px; }
+  .lab-footer { flex-direction: column; align-items: flex-start; }
+  .lab-modal { padding: 28px 20px; }
+  .lab-modal h2 { font-size: 24px; }
+}
