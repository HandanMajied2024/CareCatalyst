+
+/* ---------- Toast / a11y ---------- */
+.toast {
+  position: fixed;
+  left: 50%;
+  bottom: 104px;
+  z-index: 30;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  width: max-content;
+  max-width: calc(100% - 40px);
+  padding: 14px 20px;
+  border-radius: var(--pill);
+  background: var(--fg);
+  color: #fff;
+  font-size: 15px;
+  font-weight: 500;
+  transform: translateX(-50%);
+  animation: toast-in 0.3s ease both;
+}
+.toast svg {
+  color: var(--green);
+}
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+.skip {
+  position: absolute;
+  left: 12px;
+  top: -60px;
+  z-index: 50;
+  padding: 12px 16px;
+  border-radius: 12px;
+  background: var(--fg);
+  color: #fff;
+}
+.skip:focus {
+  top: 12px;
+}
+.page-enter {
+  animation: page-in 0.3s ease both;
+}
+.step-enter {
+  animation: step-in 0.4s ease both;
+}
+
+/* ---------- Motion ---------- */
+@keyframes bob {
+  0%,
+  100% {
+    transform: translateY(2px) rotate(-3deg);
+  }
+  50% {
+    transform: translateY(-7px) rotate(3deg);
+  }
+}
+@keyframes blink {
+  0%,
+  43%,
+  47%,
+  100% {
+    transform: scaleY(1);
+  }
+  45% {
+    transform: scaleY(0.12);
+  }
+}
+@keyframes ray {
+  0%,
+  100% {
+    opacity: 0.25;
+  }
+  50% {
+    opacity: 0.7;
+  }
+}
+@keyframes sparkle {
+  0%,
+  100% {
+    opacity: 0.35;
+    scale: 0.7;
+  }
+  50% {
+    opacity: 1;
+    scale: 1.05;
+  }
+}
+@keyframes walk-bob {
+  0%,
+  100% {
+    transform: translateY(0) rotate(-1deg);
+  }
+  50% {
+    transform: translateY(-2px) rotate(1deg);
+  }
+}
+@keyframes sun-shine {
+  0%,
+  100% {
+    opacity: 0.65;
+  }
+  50% {
+    opacity: 1;
+  }
+}
+@keyframes page-in {
+  from {
+    opacity: 0;
+    transform: translateY(7px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+@keyframes message-in {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+@keyframes typing {
+  0%,
+  60%,
+  100% {
+    transform: translateY(0);
+    opacity: 0.5;
+  }
+  30% {
+    transform: translateY(-4px);
+    opacity: 1;
+  }
+}
+@keyframes network-flow {
+  0%,
+  100% {
+    opacity: 0.4;
+  }
+  50% {
+    opacity: 1;
+  }
+}
+@keyframes step-in {
+  from {
+    opacity: 0;
+    transform: translateX(-8px);
+  }
+  to {
+    opacity: 1;
+    transform: translateX(0);
+  }
+}
+@keyframes sheet-in {
+  from {
+    opacity: 0;
+    transform: translateY(40px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+@keyframes fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+@keyframes toast-in {
+  from {
+    opacity: 0;
+    translate: 0 7px;
+  }
+  to {
+    opacity: 1;
+    translate: 0 0;
+  }
+}
+@keyframes float-app {
+  0%,
+  100% {
+    transform: rotate(-4deg) translateY(0);
+  }
+  50% {
+    transform: rotate(4deg) translateY(-4px);
+  }
+}
+.motion-off *,
+.motion-off *::before,
+.motion-off *::after {
+  animation: none !important;
+  transition: none !important;
+  scroll-behavior: auto !important;
+}
+html:has(.motion-off) dialog,
+html:has(.motion-off) dialog *,
+html:has(.motion-off) dialog::backdrop {
+  animation: none !important;
+  transition: none !important;
+}
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation: none !important;
+    transition: none !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+/* ---------- Small phones ---------- */
+@media (max-width: 559px) {
+  /* icon-only wordmark so the agent picker fits next to the avatar */
+  .wordmark {
+    font-size: 0;
+    gap: 0;
+  }
+}
+@media (max-width: 420px) {
+  .companion {
+    width: 104px;
+    height: 104px;
+  }
+  .hero-button {
+    min-width: 0;
+  }
+  .mood-scale {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .mood-scale button {
+    display: flex;
+    justify-content: center;
+    align-items: center;
+    gap: 8px;
+    min-height: 52px;
+  }
+  .mood-scale button span {
+    font-size: 18px;
+  }
+  .daily-progress {
+    grid-template-columns: auto minmax(0, 1fr) auto;
+    gap: 14px;
+  }
+  .progress-ring {
+    width: 72px;
+    height: 72px;
+  }
+  .timeline-item {
+    grid-template-columns: 48px 40px minmax(0, 1fr);
+    gap: 10px;
+  }
+}
+
+/* ---------- Tablet + desktop: two-column card grid ---------- */
+@media (min-width: 640px) {
+  main {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    grid-auto-flow: row dense;
+    gap: 24px;
+  }
+  main > * {
+    grid-column: 1 / -1;
+  }
+  main > .daily-progress,
+  main > .checkin-card,
+  main > .home-next,
+  main > .home-connect,
+  main > .timeline-card,
+  main > .permissions-card,
+  main > .profile-card,
+  main > .life-facts,
+  main > .settings-link,
+  main > .animation-settings,
+  main > .account-card {
+    grid-column: auto;
+  }
+  main > .feature-panel {
+    grid-column: 1 / -1;
+  }
+  .quick-grid {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+  }
+  .remember-card {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
+    align-items: center;
+    padding: 32px;
+  }
+  .companion {
+    width: 168px;
+    height: 168px;
+  }
+  .page-agent {
+    grid-template-columns: minmax(0, 1fr);
+    max-width: 820px;
+  }
+  .page-health,
+  .page-insurance {
+    grid-template-columns: minmax(0, 1fr);
+    max-width: 960px;
+  }
+  .bottom-sheet {
+    margin: auto;
+    border-radius: 28px;
+  }
+  .sheet-handle {
+    display: none;
+  }
+}
+@media (min-width: 1025px) {
+  body {
+    font-size: 17px;
+  }
+  .companion {
+    width: 200px;
+    height: 200px;
+  }
+  .hero-card {
+    padding: 48px 56px;
+  }
+}
