+}
+.mail-item > div {
+  display: grid;
+  justify-items: start;
+  gap: 4px;
+  min-width: 0;
+}
+.mail-meta {
+  display: flex;
+  justify-content: space-between;
+  gap: 8px;
+  width: 100%;
+}
+.mail-meta small {
+  color: var(--muted);
+  white-space: nowrap;
+}
+.mail-item h3 {
+  font-size: 18px;
+}
+.mail-item p {
+  color: var(--muted);
+}
+.mail-category {
+  display: inline-flex;
+  align-items: center;
+  min-height: 30px;
+  margin-top: 4px;
+  padding: 2px 12px;
+  border-radius: var(--pill);
+  background: var(--surface);
