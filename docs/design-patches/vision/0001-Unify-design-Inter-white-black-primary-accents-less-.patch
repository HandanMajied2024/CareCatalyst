+  }
+  .plan-main {
+    gap: 24px;
+  }
+  .context-grid {
+    grid-template-columns: 1.4fr 1fr;
+    gap: 24px;
+  }
+  .fields {
+    grid-template-columns: 1fr 1fr;
+    column-gap: 16px;
+  }
+  .pitch-mode .card {
+    padding: 32px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition: none !important;
+    animation: none !important;
+  }
+}
