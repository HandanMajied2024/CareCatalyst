+}
+
+/* ---------- Connections ---------- */
+.back-button {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  justify-self: start;
+  min-height: 44px;
+  padding: 0 14px 0 8px;
+  border: 1px solid var(--line);
+  border-radius: var(--pill);
+  background: var(--bg);
+  font-weight: 600;
+}
+.account-card {
+  display: grid;
+  gap: 16px;
+}
+.account-heading {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+.account-heading > div {
+  flex: 1;
+  min-width: 0;
+}
+.account-heading small {
+  color: var(--muted);
+  overflow-wrap: anywhere;
+}
+.connection-actions {
+  display: flex;
+  justify-content: flex-end;
+}
+.feed-tabs {
