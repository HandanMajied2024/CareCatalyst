+* {
+  box-sizing: border-box;
+}
+html {
+  scroll-behavior: smooth;
+  -webkit-text-size-adjust: 100%;
+}
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--fg);
+  font-family: var(--font);
+  font-size: 16px;
+  line-height: 1.5;
+  -webkit-font-smoothing: antialiased;
+  overflow-x: hidden;
+}
+button,
+input,
+select {
+  font: inherit;
+  color: inherit;
+}
+button {
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  touch-action: manipulation;
+  transition:
+    transform 0.18s,
+    background 0.18s,
+    border-color 0.18s;
+}
+button:active:not(:disabled) {
+  transform: scale(0.97);
+}
+button:disabled {
+  cursor: default;
+  opacity: 0.45;
+}
+button:focus-visible,
+input:focus-visible,
+select:focus-visible,
+a:focus-visible {
+  outline: 3px solid var(--blue);
+  outline-offset: 3px;
+}
+h1,
+h2,
+h3,
+p {
+  margin: 0;
+}
+h1,
+h2,
+h3 {
+  font-weight: 700;
+  line-height: 1.15;
+  letter-spacing: -0.02em;
+}
+h1 {
+  font-size: clamp(32px, 4.2vw, 44px);
+  font-weight: 800;
+}
+h2 {
+  font-size: clamp(22px, 2.6vw, 28px);
+}
+h3 {
+  font-size: 20px;
+}
+p {
+  line-height: 1.5;
+}
+svg {
+  flex-shrink: 0;
+}
+small {
+  font-size: 14px;
+}
+
+/* ---------- Shared atoms ---------- */
+.chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 32px;
+  padding: 4px 12px;
+  border-radius: var(--pill);
+  background: var(--surface);
+  color: var(--fg);
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 1.2;
+  max-width: 100%;
+}
+.chip svg {
+  color: var(--muted);
+}
+.chip-blue {
+  background: var(--blue-soft);
+}
+.chip-blue svg {
+  color: var(--blue);
+}
+.chip-green {
+  background: var(--green-soft);
+}
+.chip-green svg {
+  color: var(--green);
+}
+.chip-yellow {
+  background: var(--yellow-soft);
+}
+.chip-yellow svg {
+  color: #b38900;
+}
+.chip-red {
+  background: var(--red-soft);
+}
+.chip-red svg {
+  color: var(--red);
+}
+.chip-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.bar {
+  height: 36px;
+  border-radius: var(--pill);
+  background: var(--surface);
+  overflow: hidden;
+}
+.bar > span {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  height: 100%;
+  padding: 0 14px;
+  border-radius: var(--pill);
+  background: var(--blue);
+  color: #fff;
+  font-size: 15px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  transition: width 0.5s ease;
+}
+.bar-green > span {
+  background: var(--green);
+}
+
+.icon-box {
+  display: grid;
+  place-items: center;
+  width: 48px;
+  height: 48px;
+  flex-shrink: 0;
+  border-radius: 14px;
+  background: var(--surface);
+  color: var(--fg);
+}
+.icon-box.blue {
+  background: var(--blue-soft);
+  color: var(--blue);
+}
+.icon-box.green {
+  background: var(--green-soft);
+  color: var(--green);
+}
+.icon-box.red {
+  background: var(--red-soft);
+  color: var(--red);
+}
+.icon-box.yellow {
+  background: var(--yellow-soft);
+  color: #8a6a00;
+}
+
+.card {
+  background: var(--bg);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 24px;
+}
+
+.primary,
+.outline-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  min-height: 52px;
+  padding: 0 24px;
+  border-radius: var(--pill);
+  font-size: 17px;
+  font-weight: 600;
+}
+.primary {
+  border: 0;
+  background: var(--fg);
+  color: #fff;
+}
+.primary:hover:not(:disabled) {
+  background: #2a2a2a;
+}
+.primary.danger {
+  background: var(--red);
+}
+.outline-button {
+  border: 1.5px solid var(--line);
+  background: var(--bg);
+}
+.outline-button:hover:not(:disabled) {
+  border-color: var(--fg);
+}
+.full {
+  width: 100%;
+}
+
+.text-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 44px;
+  padding: 0 4px;
+  border: 0;
+  background: none;
+  color: var(--blue);
+  font-size: 16px;
+  font-weight: 600;
+}
+.centered {
+  display: flex;
+  margin: 8px auto 0;
+}
+
+.icon-button {
+  display: grid;
+  place-items: center;
+  width: 48px;
+  height: 48px;
+  flex-shrink: 0;
+  border: 1px solid var(--line);
+  border-radius: var(--pill);
+  background: var(--bg);
+}
+.icon-button.selected {
+  border-color: var(--blue);
+  background: var(--blue-soft);
+  color: var(--blue);
+}
+
+.section-title {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 12px;
+}
+
+.prototype-note {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  color: var(--muted);
+  font-size: 14px;
+  text-align: center;
+  margin-top: 8px;
+}
+
+/* ---------- Shell ---------- */
+.app-shell {
+  min-height: 100dvh;
+  background: var(--bg);
+}
+.app-header {
+  position: sticky;
+  top: 0;
+  z-index: 10;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  min-height: 72px;
+  padding: 12px var(--gutter);
+  background: rgba(255, 255, 255, 0.88);
+  backdrop-filter: blur(16px);
+}
+.wordmark {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 44px;
+  border: 0;
+  background: none;
+  padding: 0;
+  font-size: 22px;
+  font-weight: 800;
+  letter-spacing: -0.03em;
+}
+.brand-icon {
+  display: grid;
+  place-items: center;
+  width: 40px;
+  height: 40px;
+  border-radius: 12px;
+  background: var(--fg);
+  color: #fff;
+}
+.avatar {
+  width: 48px;
+  height: 48px;
+  border-radius: var(--pill);
+  border: 1px solid var(--line);
+  background: var(--surface);
+  font-size: 18px;
+  font-weight: 700;
+  /* leave room for the floating agent picker on the left of the avatar */
+}
+
+main {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 20px;
+  align-items: start;
+  width: 100%;
+  max-width: 1200px;
+  margin: 0 auto;
+  padding: 8px var(--gutter) 140px;
+}
+main > * {
+  min-width: 0;
+}
+
+.page-title {
+  padding: 16px 0 8px;
+}
+.page-title h1 {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px;
+}
+.greeting-sun {
+  display: inline-grid;
+  color: #e0a800;
+}
+
+/* ---------- Home ---------- */
+.hero-card {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  padding: clamp(24px, 4vw, 40px);
+  border: 1px solid var(--line);
+  border-radius: 28px;
+  background: var(--bg);
+}
+.hero-card::before {
+  /* airbrush blob */
+  content: "";
+  position: absolute;
+  z-index: -1;
+  inset: -40% -20% -40% 30%;
+  background:
+    radial-gradient(closest-side at 35% 45%, rgba(31, 94, 255, 0.16), transparent),
+    radial-gradient(closest-side at 70% 60%, rgba(20, 164, 77, 0.1), transparent),
+    radial-gradient(closest-side at 55% 25%, rgba(255, 196, 0, 0.14), transparent);
+  filter: blur(30px);
+}
+.hero-body {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+.hero-body > div:first-child {
+  display: grid;
+  justify-items: start;
+  gap: 18px;
+  min-width: 0;
+}
+.hero-body h2 {
+  font-size: clamp(28px, 4vw, 44px);
+  font-weight: 800;
+}
+.hero-button {
+  min-width: 180px;
+  background: var(--blue);
+}
+.hero-button:hover:not(:disabled) {
+  background: #1a50dd;
+}
+
+.companion {
+  position: relative;
+  width: 140px;
+  height: 140px;
+  flex-shrink: 0;
+}
+.companion > svg {
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+}
+.buddy {
+  transform-origin: 70px 75px;
+  animation: bob 3.8s ease-in-out infinite;
+}
+.eyes {
+  transform-origin: 72px 71px;
+  animation: blink 6s infinite;
+}
+.companion-ray {
+  position: absolute;
+  width: 2px;
+  height: 11px;
+  border-radius: 2px;
+  background: var(--blue);
+  opacity: 0.4;
+  animation: ray 3.8s ease-in-out infinite;
+}
+.r1 {
+  top: 11px;
+  left: 35px;
+  transform: rotate(-30deg);
+}
+.r2 {
+  top: 4px;
+  left: 75px;
+}
+.r3 {
+  top: 20px;
+  right: 14px;
+  transform: rotate(40deg);
+}
+.sparkle {
+  position: absolute;
+  color: var(--yellow);
+  font-size: 19px;
+  animation: sparkle 3s ease-in-out infinite;
+}
+.s1 {
+  left: 4px;
+  bottom: 16px;
+}
+.s2 {
+  right: 0;
+  top: 12px;
+  font-size: 15px;
+  color: var(--blue);
+  animation-delay: 1s;
+}
+.companion.small {
+  width: 56px;
+  height: 56px;
+}
+.companion.small .companion-ray,
+.companion.small .sparkle {
+  display: none;
+}
+.companion.small .buddy {
+  animation-duration: 3s;
+}
+.thinking .buddy {
+  animation: bob 1s ease-in-out infinite;
+}
+
+/* Daily progress + meds */
+.daily-progress,
+.checkin-card,
+.feature-panel {
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 24px;
+  background: var(--bg);
+}
+.daily-progress {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 18px;
+}
+.daily-progress > div:nth-child(2) {
+  display: grid;
+  gap: 10px;
+}
+.progress-ring {
+  position: relative;
+  display: grid;
+  place-items: center;
+  width: 84px;
+  height: 84px;
+  border-radius: 50%;
+  background: conic-gradient(var(--blue) var(--progress), var(--surface) 0);
+  transition: background 0.4s;
+}
+.progress-ring.done {
+  background: conic-gradient(var(--green) var(--progress), var(--surface) 0);
+}
+.progress-ring::before {
+  content: "";
+  position: absolute;
+  inset: 9px;
+  border-radius: 50%;
+  background: var(--bg);
+}
+.progress-ring span {
+  position: relative;
+  font-size: 22px;
+  font-weight: 800;
+  font-variant-numeric: tabular-nums;
+}
+
+.feature-panel {
+  display: grid;
+  gap: 12px;
+  animation: page-in 0.3s ease both;
+}
+.feature-panel-head {
+  margin-bottom: 4px;
+}
+.med-row {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 14px;
+  padding: 12px 0;
+  border-bottom: 1px solid var(--line);
+}
+.med-orb {
+  display: grid;
+  place-items: center;
+  width: 48px;
+  height: 48px;
+  border-radius: 50%;
+  background: var(--yellow-soft);
+  color: #8a6a00;
+}
+.med-orb.taken {
+  background: var(--green-soft);
+  color: var(--green);
+}
+.med-row strong {
+  display: block;
+  font-size: 17px;
+}
+.med-row small {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  color: var(--muted);
+}
+.check-button {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 44px;
+  padding: 0 16px;
+  border: 1.5px solid var(--line);
+  border-radius: var(--pill);
+  background: var(--bg);
+  font-size: 15px;
+  font-weight: 600;
+}
+.check-button.done {
+  border-color: var(--green);
+  background: var(--green-soft);
+  color: var(--fg);
+}
+.check-button.done svg {
+  color: var(--green);
+}
+.agent-nudge,
+.care-coach,
+.next-step,
+.settings-link {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  width: 100%;
+  min-height: 64px;
+  padding: 14px 18px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: var(--bg);
+  text-align: left;
+  font-size: 17px;
+}
+.agent-nudge strong,
+.care-coach strong,
+.settings-link strong {
+  flex: 1;
+}
+.agent-nudge > svg,
+.next-step > svg,
+.settings-link > svg {
+  color: var(--muted);
+}
+.agent-nudge:hover,
+.care-coach:hover,
+.next-step:hover,
+.settings-link:hover,
+.connection-tile:hover,
+.quick-grid button:hover,
+.mail-item:hover {
+  border-color: #c4c4c4;
+}
+
+/* Check-in */
+.checkin-card {
+  display: grid;
+  gap: 18px;
+}
+.checkin-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+.pulse-face {
+  display: grid;
+  place-items: center;
+  width: 52px;
+  height: 52px;
+  flex-shrink: 0;
+  border-radius: 50%;
+  background: var(--yellow-soft);
+  font-size: 26px;
+}
+.mood-scale {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 8px;
+}
+.mood-scale button {
+  display: grid;
+  justify-items: center;
+  gap: 4px;
+  min-height: 76px;
+  padding: 10px 4px;
+  border: 1.5px solid var(--line);
+  border-radius: 16px;
+  background: var(--bg);
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 1.2;
+}
+.mood-scale button span {
+  font-size: 22px;
+}
+.mood-scale button.active {
+  border-color: var(--blue);
+  background: var(--blue-soft);
+}
+.checkin-card > .text-link {
+  justify-self: start;
+}
+
+/* Quick actions */
+.quick-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+}
+.quick-grid button {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 12px;
+  min-height: 112px;
+  padding: 16px;
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  background: var(--bg);
+  text-align: left;
+  font-size: 17px;
+}
+.care-coach .coach-cta {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--blue);
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+/* Next step + connections */
