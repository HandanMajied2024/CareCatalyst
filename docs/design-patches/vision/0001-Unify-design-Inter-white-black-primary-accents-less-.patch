+}
+.fact small {
+  color: var(--muted);
+}
+.fact p {
+  font-size: 17px;
+  font-weight: 500;
+}
+.animation-settings {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 14px 18px;
+}
+.animation-settings strong {
+  flex: 1;
+  font-size: 17px;
+}
+.toggle {
+  position: relative;
+  width: 56px;
+  height: 34px;
+  flex-shrink: 0;
