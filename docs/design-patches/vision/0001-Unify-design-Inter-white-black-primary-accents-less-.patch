+/* CarePulse — Health + Card tabs and the floating agent picker. Tokens live in styles.css. */
+
+/* ---------- Simple tabs (Health, Card) ---------- */
+.simple-tab {
+  display: grid;
+  gap: 24px;
+}
+.tab-head {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding-top: 16px;
+}
+.tab-icon {
+  display: grid;
+  place-items: center;
+  width: 56px;
+  height: 56px;
+  flex-shrink: 0;
+  border-radius: 16px;
+}
+.tab-icon.red {
+  background: var(--red-soft);
+  color: var(--red);
+}
+.tab-icon.blue {
+  background: var(--blue-soft);
+  color: var(--blue);
+}
+
+/* Health */
+.health-grid {
+  display: grid;
+  gap: 24px;
+}
+.score-block {
+  display: grid;
+  justify-items: center;
+  gap: 20px;
+  padding: 28px 24px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+}
+.score-orbit {
+  --tone: var(--green);
+  position: relative;
+  display: grid;
+  place-items: center;
+  align-content: center;
+  width: 200px;
+  height: 200px;
+  border-radius: 50%;
+  background: conic-gradient(var(--tone) var(--score), var(--surface) 0);
+}
+.score-orbit.tone-yellow {
+  --tone: var(--yellow);
+}
+.score-orbit.tone-red {
+  --tone: var(--red);
+}
+.score-orbit::after {
+  content: "";
+  position: absolute;
+  inset: 16px;
+  border-radius: 50%;
+  background: var(--bg);
+}
+.score-orbit span,
+.score-orbit small {
+  position: relative;
+  z-index: 1;
+}
+.score-orbit span {
+  font-size: 56px;
+  font-weight: 800;
+  line-height: 1;
+  letter-spacing: -0.03em;
+  font-variant-numeric: tabular-nums;
+}
+.score-orbit small {
+  color: var(--muted);
+  font-size: 16px;
+  font-weight: 600;
+}
+.score-slider {
+  display: grid;
+  gap: 8px;
+  width: 100%;
+  max-width: 320px;
+}
+.score-slider label {
+  color: var(--muted);
+  font-size: 14px;
+  font-weight: 600;
+  text-align: center;
+}
+.score-slider input {
+  width: 100%;
+  min-height: 44px;
+  accent-color: var(--fg);
+}
+.visual-bars {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  align-items: end;
+  gap: 12px;
+  height: 260px;
+  padding: 24px 20px 16px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+}
+.visual-bars > div {
+  display: grid;
+  grid-template-rows: 1fr auto;
+  justify-items: center;
+  gap: 8px;
+  height: 100%;
+}
+.visual-bars i {
+  align-self: end;
+  display: flex;
+  justify-content: center;
+  width: 100%;
+  max-width: 64px;
+  padding-top: 8px;
+  border-radius: 14px 14px 6px 6px;
+  color: #fff;
+}
+.visual-bars i b {
+  font-size: 15px;
+  font-style: normal;
+  font-weight: 700;
+}
+.visual-bars span {
+  font-size: 14px;
+  font-weight: 600;
+}
+.visual-bars .blue {
+  background: var(--blue);
+}
+.visual-bars .green {
+  background: var(--green);
+}
+.visual-bars .yellow {
+  background: var(--yellow);
+  color: var(--fg);
+}
+.visual-bars .red {
+  background: var(--red);
+}
+.glass-action {
+  display: inline-flex;
+  align-items: center;
+  justify-self: start;
+  gap: 8px;
+  min-height: 48px;
+  padding: 0 20px;
+  border: 1.5px solid var(--line);
+  border-radius: var(--pill);
+  background: var(--bg);
+  font-size: 16px;
+  font-weight: 600;
+}
+
+/* Insurance */
+.insurance-card {
+  position: relative;
+  overflow: hidden;
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 16px;
+  min-height: 200px;
+  padding: 28px;
+  border-radius: 24px;
+  background: var(--fg);
+  color: #fff;
+}
+.insurance-card::before {
+  content: "";
+  position: absolute;
+  inset: 40% -20% -60% 30%;
+  background: radial-gradient(closest-side, rgba(31, 94, 255, 0.55), transparent);
+  filter: blur(20px);
+}
+.insurance-card > * {
+  position: relative;
+}
+.insurance-card > div {
+  display: grid;
+  gap: 6px;
+}
+.insurance-card small {
+  color: rgba(255, 255, 255, 0.7);
+  font-size: 14px;
+}
+.insurance-card strong {
+  font-size: 26px;
+  letter-spacing: -0.02em;
+}
+.insurance-card span {
+  font-size: 16px;
+}
+.coverage-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px;
+}
+.coverage {
+  --tone: var(--blue);
+  --soft: var(--blue-soft);
+  display: grid;
+  justify-items: center;
+  gap: 6px;
+  padding: 18px 8px;
+  border-radius: var(--radius);
+  background: var(--soft);
+  text-align: center;
+}
+.coverage svg {
+  color: var(--tone);
+}
+.coverage.tone-green {
+  --tone: var(--green);
+  --soft: var(--green-soft);
+}
+.coverage.tone-yellow {
+  --tone: #b38900;
+  --soft: var(--yellow-soft);
+}
+.coverage small {
+  color: var(--muted);
+}
+.coverage strong {
+  font-size: 17px;
+}
+.share-row {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  min-height: 72px;
+  padding: 12px 18px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  cursor: pointer;
+}
+.share-row b {
+  flex: 1;
+  font-size: 17px;
+  font-weight: 600;
+}
+.card-illustration {
+  display: grid;
+  place-items: center;
+  height: 200px;
+  border-radius: var(--radius);
+  background:
+    radial-gradient(closest-side at 50% 55%, rgba(31, 94, 255, 0.14), transparent),
+    var(--surface);
+  color: var(--blue);
+}
+.card-illustration svg {
+  animation: float-app 4s ease-in-out infinite;
+}
+
+/* ---------- Floating agent picker ---------- */
+.agent-floating {
+  position: fixed;
+  top: 12px;
+  right: calc(var(--gutter) + 60px);
+  z-index: 12;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 48px;
+  padding: 0 6px 0 14px;
+  border: 1px solid var(--line);
+  border-radius: var(--pill);
+  background: rgba(255, 255, 255, 0.9);
+  backdrop-filter: blur(16px);
+  color: var(--blue);
+}
+.agent-floating select {
+  max-width: 132px;
+  min-height: 44px;
+  border: 0;
+  background: transparent;
+  color: var(--fg);
+  font-size: 15px;
+  font-weight: 600;
+  cursor: pointer;
+  outline: none;
+}
+
+@media (max-width: 400px) {
+  .agent-floating select {
+    max-width: 92px;
+    font-size: 14px;
+  }
+  .coverage-grid {
+    gap: 8px;
+  }
+}
+@media (min-width: 640px) {
+  .health-grid {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+    align-items: stretch;
+  }
+  .visual-bars {
+    height: auto;
+    min-height: 300px;
+  }
+  .insurance-tab {
+    max-width: 640px;
+    width: 100%;
+    justify-self: center;
+  }
+}
+@media (min-width: 1025px) {
+  .agent-floating {
+    right: var(--gutter);
+    top: 16px;
+  }
+}
