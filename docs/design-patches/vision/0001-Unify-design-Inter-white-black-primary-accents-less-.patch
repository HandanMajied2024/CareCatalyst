+/* CarePulse pitch mode. Tokens live in index.html :root (docs/design-system.md).
+   Mobile < 640 · Tablet 640–1024 · Desktop > 1024 */
+
+/* ---------- Base ---------- */
+.ic {
+  width: 20px;
+  height: 20px;
+  flex-shrink: 0;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.8;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+  border: 0;
+}
+.skip-link {
+  position: absolute;
+  left: 16px;
+  top: -80px;
+  z-index: 20;
+  background: var(--fg);
+  color: #fff;
+  padding: 12px 18px;
+  border-radius: var(--pill);
+  text-decoration: none;
+}
+.skip-link:focus {
+  top: 12px;
+}
+body.pitch-mode {
+  background: var(--bg);
+}
+.pitch-mode .shell {
+  max-width: none;
+  margin: 0;
+  padding: 0;
+  min-height: 100dvh;
+}
+.pitch-mode h2 {
+  font-size: clamp(24px, 2.6vw, 28px);
+  margin: 0;
+}
+.pitch-mode h3 {
+  font-size: 20px;
+  margin: 0;
+}
+.pitch-mode p {
+  margin: 0;
+}
+
+/* ---------- Buttons, pills, dots, bars ---------- */
+.primary,
+.secondary-action {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  min-height: 48px;
+  padding: 0 22px;
+  border: 0;
+  border-radius: var(--pill);
+  font-size: 16px;
+  font-weight: 600;
+}
+.primary {
+  background: var(--blue);
+  color: #fff;
+}
+.primary:hover {
+  filter: brightness(1.08);
+}
+.primary:disabled {
+  background: #d4d4d4;
+  color: var(--muted);
+  cursor: not-allowed;
+  filter: none;
+}
+.secondary-action {
+  background: var(--surface);
+  color: var(--fg);
+}
+.icon-button {
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  flex-shrink: 0;
+  border: 0;
+  border-radius: 50%;
+  background: var(--surface);
+  color: var(--fg);
+}
+.icon-button:hover {
+  background: var(--blue-soft);
+  color: var(--blue);
+}
+.icon-button[aria-pressed="true"] {
+  background: var(--blue);
+  color: #fff;
+}
+.tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 32px;
+  padding: 0 12px;
+  border-radius: var(--pill);
+  background: var(--surface);
+  font-size: 14px;
+  font-weight: 600;
+  white-space: nowrap;
+}
+.tag .ic {
+  width: 16px;
+  height: 16px;
+}
+.tag.yellow {
+  background: var(--yellow-soft);
+}
+.tag.yellow .ic {
+  color: #8a6a00;
+}
+.tag.green {
+  background: var(--green-soft);
+}
+.tag.green .ic {
+  color: var(--green);
+}
+.tag.blue {
+  background: var(--blue-soft);
+}
+.tag.blue .ic {
+  color: var(--blue);
+}
+.tag.red {
+  background: var(--red-soft);
+}
+.dot {
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  flex-shrink: 0;
+  border-radius: 50%;
+  background: var(--surface);
+  color: var(--fg);
+}
+.dot.blue {
+  background: var(--blue-soft);
+  color: var(--blue);
+}
+.dot.green {
+  background: var(--green-soft);
+  color: var(--green);
+}
+.dot.yellow {
+  background: var(--yellow);
+  color: var(--fg);
+}
+.dot.red {
+  background: var(--red-soft);
+  color: var(--red);
+}
+.dot.big {
+  width: 56px;
+  height: 56px;
+}
+.dot.big .ic {
+  width: 26px;
+  height: 26px;
+}
+.bar {
+  position: relative;
+  height: 32px;
+  border-radius: var(--pill);
+  background: var(--surface);
+  overflow: hidden;
+}
+.bar-fill {
+  position: absolute;
+  inset: 0 auto 0 0;
+  border-radius: var(--pill);
+  transition: width 0.3s;
+}
+.bar.green .bar-fill {
+  background: var(--green);
+}
+.bar.blue .bar-fill {
+  background: var(--blue);
+}
+.bar.yellow .bar-fill {
+  background: var(--yellow);
+}
+.bar b {
+  position: absolute;
+  left: 14px;
+  top: 50%;
+  transform: translateY(-50%);
+  font-size: 14px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  color: var(--fg);
+  white-space: nowrap;
+}
+.bar-fill {
+  overflow: hidden;
+}
+.bar-fill b {
+  color: #fff;
+}
+
+/* ---------- Cards ---------- */
+.pitch-mode .card {
+  background: var(--bg);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  padding: 20px;
+  margin: 0;
+  min-width: 0;
+}
+.card-head {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-bottom: 20px;
+}
+.card-head h2 {
+  margin-right: auto !important;
+}
+
+/* ---------- Shell: navigation ---------- */
+.pitch-brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 44px;
+  color: var(--fg);
+  text-decoration: none;
+  font-size: 22px;
+  font-weight: 800;
+  letter-spacing: -0.02em;
+}
+.pitch-brand .logo {
+  margin: 0;
+}
+.pitch-brand .logo .ic {
+  width: 20px;
+  height: 20px;
+}
+/* Mobile + tablet: bottom nav bar */
+.sidebar {
+  position: fixed;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 10;
+  background: var(--bg);
+  border-top: 1px solid var(--line);
+  padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
+}
+.sidebar > .pitch-brand,
+.sidebar-bottom {
+  display: none;
+}
+.side-nav {
+  display: flex;
+  justify-content: space-around;
+  gap: 4px;
+}
+.side-nav button {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+  min-height: 56px;
+  border: 0;
+  border-radius: var(--radius-sm);
+  background: none;
+  color: var(--muted);
+  font-size: 14px;
+  font-weight: 500;
+}
+.side-nav button .ic {
+  width: 24px;
+  height: 24px;
+}
+.side-nav button[aria-current="page"] {
+  color: var(--blue);
+  font-weight: 700;
+}
+.pitch-workspace {
+  padding: 0 var(--gutter) calc(112px + env(safe-area-inset-bottom));
+}
+.pitch-topbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 16px 0 8px;
+}
+.engine-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 44px;
+  max-width: 60vw;
+  padding: 0 16px;
+  border: 1px solid var(--line);
+  border-radius: var(--pill);
+  background: var(--bg);
+  font-size: 15px;
+  font-weight: 600;
+}
+.engine-chip span {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+#pitch-main {
+  padding: 0;
+  outline: none;
+}
+.page-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+  margin: 16px 0 24px;
+}
+.page-heading h1 {
+  margin: 0;
+}
+.date-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 36px;
+  padding: 0 14px;
+  border-radius: var(--pill);
+  background: var(--surface);
+  font-size: 14px;
+  font-weight: 500;
+}
+.date-chip .ic {
+  width: 16px;
+  height: 16px;
+}
+
+/* ---------- Today ---------- */
+.today-grid {
+  display: grid;
+  gap: 16px;
+}
+.hero-card {
+  position: relative;
+  overflow: hidden;
+  isolation: isolate;
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  align-items: flex-start;
+  gap: 20px;
+  min-height: 240px;
+  padding: 28px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+}
+.hero-card h2 {
+  font-size: clamp(32px, 4.4vw, 48px) !important;
+  font-weight: 800;
+  max-width: 12ch;
+}
+.blob {
+  position: absolute;
+  inset: -30%;
+  z-index: -1;
+  background:
+    radial-gradient(closest-side at 72% 28%, rgb(31 94 255 / 0.22), transparent),
+    radial-gradient(closest-side at 88% 70%, rgb(255 196 0 / 0.22), transparent),
+    radial-gradient(closest-side at 55% 85%, rgb(20 164 77 / 0.14), transparent),
+    radial-gradient(closest-side at 92% 12%, rgb(229 38 43 / 0.1), transparent);
+  filter: blur(30px);
+  pointer-events: none;
+}
+.route-visual {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 20px;
+}
+.route-stop {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+  font-size: 16px;
+  font-variant-numeric: tabular-nums;
+}
+.route-line {
+  flex: 1;
+  min-width: 12px;
+  height: 0;
+  border-top: 2px dashed var(--line);
+  margin-bottom: 32px;
+}
+.context-mini {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+.context-mini > div {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+}
+.context-mini strong {
+  font-size: 18px;
+}
+.context-mini span:not(.dot) {
+  color: var(--muted);
+}
+
+/* ---------- Agent ---------- */
+.agent-layout {
+  display: grid;
+  gap: 16px;
+}
+.agent-top {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+.agent-top h3 {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.agent-top .voice {
+  margin-left: auto;
+}
+.messages {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  margin: 20px 0;
+}
+.message p {
+  padding: 14px 18px;
+  border-radius: var(--radius);
+  font-size: 16px;
+  line-height: 1.5;
+  color: var(--fg);
+  max-width: min(85%, 640px);
+}
+.message.agent p {
+  background: var(--surface);
+  border-bottom-left-radius: 6px;
+}
+.message.you {
+  display: flex;
+  justify-content: flex-end;
+}
+.message.you p {
+  background: var(--blue);
+  color: #fff;
+  border-bottom-right-radius: 6px;
+}
+.suggestions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 16px;
+}
+.suggestions button {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: 44px;
+  padding: 0 16px;
+  border: 1px solid var(--line);
+  border-radius: var(--pill);
+  background: var(--bg);
+  font-size: 15px;
+  font-weight: 500;
+}
+.suggestions button .ic {
+  color: var(--blue);
+}
+.suggestions button:hover {
+  border-color: var(--blue);
+}
+.chat-form {
+  display: flex;
+  gap: 8px;
+}
+.chat-form input {
+  flex: 1;
+  min-width: 0;
+  min-height: 52px;
+  padding: 0 20px;
+  border: 1px solid var(--line);
+  border-radius: var(--pill);
+  font-size: 16px;
+}
+.chat-form input:focus {
+  border-color: var(--blue);
+  outline: none;
+}
+.send {
+  display: grid;
+  place-items: center;
+  width: 52px;
+  height: 52px;
+  flex-shrink: 0;
+  border: 0;
+  border-radius: 50%;
+  background: var(--blue);
+  color: #fff;
+}
+.agent-aside h3 {
+  margin-bottom: 12px !important;
+}
+.context-list {
+  list-style: none;
+  margin: 0 0 20px;
+  padding: 0;
+}
+.context-list li {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 10px 0;
+  border-bottom: 1px solid var(--line);
+  font-size: 16px;
+}
+.context-list li:last-child {
+  border-bottom: 0;
+}
+.context-list .dot {
+  width: 40px;
+  height: 40px;
+}
+.agent-aside .primary {
+  width: 100%;
+}
+
+/* ---------- Plan ---------- */
+.plan-grid,
+.plan-main {
+  display: grid;
+  gap: 16px;
+  min-width: 0;
+}
+.journey {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: grid;
+  gap: 18px;
+}
+.journey-stop {
+  display: grid;
+  grid-template-columns: 44px 56px minmax(0, 1fr);
+  align-items: center;
+  gap: 12px;
+}
+.journey-stop .time {
+  font-size: 16px;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+}
+.journey-stop h3 {
+  font-size: 18px !important;
+}
+.journey-stop p {
+  color: var(--muted);
+  overflow-wrap: anywhere;
+}
+.support-note {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  flex-wrap: wrap;
+  margin-top: 20px;
+  padding: 12px 16px;
+  border-radius: var(--radius-sm);
+  background: var(--surface);
+}
+.support-note .tag {
+  margin-left: auto;
+  background: var(--yellow-soft);
+}
+.activity {
