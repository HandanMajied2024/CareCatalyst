+    grid-row: 1 / span 2;
+    min-height: 400px;
+    padding: 48px;
+  }
+  .agent-layout {
+    grid-template-columns: minmax(0, 1fr) 360px;
+    gap: 24px;
+    align-items: start;
+  }
+  .agent-aside .context-list {
